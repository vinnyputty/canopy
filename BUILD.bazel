load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "broker/**/*.ts", "tests/**/*.ts"]) + ["package.json", "tsconfig.json", "tests/fixtures/sidebar-root-view.json"],
)

js_binary(
    name = "build_tool",
    entry_point = "tools/build.mjs",
    data = [":node_modules", ":sources"],
)

js_run_binary(
    name = "build",
    tool = ":build_tool",
    srcs = [":sources"],
    out_dirs = ["dist"],
)

js_test(
    name = "test",
    entry_point = "tools/test.mjs",
    data = [":node_modules", ":sources", "tools/smoke-relationships.mjs", "tools/smoke-github.mjs"],
)

js_test(
    name = "typecheck",
    entry_point = "tools/check.mjs",
    args = ["types"],
    data = [":node_modules", ":sources"],
)

js_test(
    name = "format_check",
    entry_point = "tools/check.mjs",
    args = ["format"],
    data = [":node_modules", ":sources", ".prettierrc.json", "README.md"] + glob(["tools/*.mjs", "docs/*.md", ".github/**/*.yml"]) + ["tools/AppRun"],
)

js_test(
    name = "portable_checks",
    entry_point = "tools/portable-check.mjs",
    data = [":node_modules", ":sources", ".prettierrc.json", "README.md"] + glob(["tools/*.mjs", "docs/*.md", ".github/**/*.yml"]) + ["tools/AppRun"],
)

js_binary(
    name = "dev",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json"],
    args = ["dev"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "demo",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json"],
    args = ["demo"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "demo_check",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json", "tools/demo-check.mjs"],
    args = ["demo-check"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "smoke",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json", "tools/smoke.mjs", "tools/smoke-sidebar.mjs", "tests/fixtures/sidebar-root-view.json", "tools/smoke-child.mjs", "tools/smoke-bulk.mjs", "tools/smoke-refresh.mjs", "tools/smoke-search.mjs", "tools/smoke-pickers.mjs", "tools/smoke-workflow.mjs", "tools/smoke-preview.mjs", "tools/smoke-github.mjs", "tools/smoke-relationships.mjs"],
    args = ["smoke"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "smoke_github",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json", "tools/smoke-github.mjs", "tools/smoke-github-cli.mjs"],
    args = ["smoke-github"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "package",
    entry_point = "tools/desktop.mjs",
    data = ["tools/windows-signing.mjs", "tools/windows-native.ps1", "tools/windows-native.cs", "tools/release.mjs", ":build", ":node_modules", "package.json", "tools/AppRun"],
    args = ["package"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "packaged_smoke",
    entry_point = "tools/desktop.mjs",
    data = [":node_modules", "package.json", "tools/packaged-smoke.mjs", "tools/linux-package-check.mjs", "tools/appimage-observer.mjs", "tools/AppRun"],
    args = ["packaged-smoke"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "packaged_smoke_failure",
    entry_point = "tools/packaged-smoke-failure.mjs",
    data = [":node_modules", "package.json", "tools/packaged-smoke.mjs", "tools/linux-package-check.mjs", "tools/appimage-observer.mjs", "tools/AppRun"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "broker",
    entry_point = "tools/broker.mjs",
    data = [":build"],
    tags = ["manual"],
)

js_binary(
    name = "ci",
    entry_point = "tools/ci.mjs",
    data = ["tools/packaged-check-log.mjs"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_test(
    name = "release_checks",
    entry_point = "tools/release.test.mjs",
    data = ["tools/release.mjs", "tools/windows-signing.mjs", "tools/windows-signing-fixture.mjs", ".github/workflows/publish.yml"],
)

js_test(
    name = "windows_signing_checks",
    entry_point = "tools/windows-signing.test.mjs",
    data = ["tools/windows-signing.mjs", "tools/release.mjs", "tools/windows-signing-fixture.mjs", "tools/windows-lifecycle.mjs", "tools/windows-lifecycle.test.mjs", "tools/windows-signing-scope.test.mjs", "tools/windows-native-deadline.test.mjs", "tools/desktop.mjs", "tools/windows-native.ps1", "tools/windows-native.cs"],
)
