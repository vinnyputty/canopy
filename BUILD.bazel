load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

filegroup(
    name = "sources",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx", "src/**/*.css", "broker/**/*.ts", "tests/**/*.ts"]) + ["package.json", "tsconfig.json"],
)

js_binary(
    name = "build_tool",
    entry_point = "tools/build.mjs",
    data = [":node_modules", ":sources"],
)

js_run_binary(
    name = "build",
    tool = ":build_tool",
    srcs = [":sources"],
    out_dirs = ["dist"],
)

js_test(
    name = "test",
    entry_point = "tools/test.mjs",
    data = [":node_modules", ":sources"],
)

js_test(
    name = "typecheck",
    entry_point = "tools/check.mjs",
    args = ["types"],
    data = [":node_modules", ":sources"],
)

js_test(
    name = "format_check",
    entry_point = "tools/check.mjs",
    args = ["format"],
    data = [":node_modules", ":sources", ".prettierrc.json", "README.md"] + glob(["tools/*.mjs", "docs/*.md", ".github/**/*.yml"]),
)

js_test(
    name = "portable_checks",
    entry_point = "tools/portable-check.mjs",
    data = [":node_modules", ":sources", ".prettierrc.json", "README.md"] + glob(["tools/*.mjs", "docs/*.md", ".github/**/*.yml"]),
)

js_binary(
    name = "dev",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json"],
    args = ["dev"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "smoke",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json", "tools/smoke.mjs", "tools/smoke-refresh.mjs", "tools/smoke-pickers.mjs"],
    args = ["smoke"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "package",
    entry_point = "tools/desktop.mjs",
    data = [":build", ":node_modules", "package.json"],
    args = ["package"],
    patch_node_fs = False,
    tags = ["manual"],
)

js_binary(
    name = "broker",
    entry_point = "tools/broker.mjs",
    data = [":build"],
    tags = ["manual"],
)

js_binary(
    name = "ci",
    entry_point = "tools/ci.mjs",
    patch_node_fs = False,
    tags = ["manual"],
)
